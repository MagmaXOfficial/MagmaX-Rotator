# MagmaX Rotator — optional environment configuration
# Copy to .env if you want to change defaults. Values are read at startup.

# Bind address. Keep 127.0.0.1 for localhost-only (default).
MAGMAX_HOST=127.0.0.1
MAGMAX_PORT=3000

# Where SQLite, the master key and installed skills live.
# MAGMAX_DATA_DIR=./data

# 32-byte master key (hex or base64) used to encrypt provider keys.
# If unset, data/master.key is generated with 0600 permissions on first run.
# MAGMAX_MASTER_KEY=

# debug | info | warn | error
MAGMAX_LOG_LEVEL=info
